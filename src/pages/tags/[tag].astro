---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, slugifyTerm, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const byTag = new Map<string, { tag: string; posts: Post[] }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTerm(tag);
      const entry = byTag.get(slug) ?? { tag, posts: [] };
      entry.posts.push(post);
      byTag.set(slug, entry);
    }
  }
  return [...byTag.entries()].map(([slug, { tag, posts }]) => ({
    params: { tag: slug },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Posts tagged “${tag}”`}>
  <BackLink href="/tags/" label="All tags" />
  <h1 class="page-title">#{tag}</h1>
  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</BaseLayout>
