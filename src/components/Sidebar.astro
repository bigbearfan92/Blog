---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { AUTHOR_NAME, AUTHOR_BIO } from '../site.config.mjs';
import { getPublishedPosts, getArchiveMonths, slugifyTerm } from '../lib/posts';

// The avatar is whatever file is named "avatar" in src/assets/ —
// avatar.jpg, avatar.png, avatar.webp or avatar.svg all work.
const avatarModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/avatar.{jpg,jpeg,png,webp,svg}',
  { eager: true }
);
const avatar = Object.values(avatarModules)[0]?.default;

const posts = await getPublishedPosts();
const allMonths = await getArchiveMonths();
// Keep the widget a sensible height: show the last year's worth of months,
// with a link to the full archive when there's more.
const months = allMonths.slice(0, 12);
const hasOlder = allMonths.length > months.length;

const categoryCounts = new Map<string, { name: string; count: number }>();
const tagCounts = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  const catKey = slugifyTerm(post.data.category);
  const cat = categoryCounts.get(catKey) ?? { name: post.data.category, count: 0 };
  cat.count += 1;
  categoryCounts.set(catKey, cat);
  for (const tag of post.data.tags) {
    const tagKey = slugifyTerm(tag);
    const entry = tagCounts.get(tagKey) ?? { name: tag, count: 0 };
    entry.count += 1;
    tagCounts.set(tagKey, entry);
  }
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1].count - a[1].count);
const tags = [...tagCounts.entries()].sort((a, b) => b[1].count - a[1].count);
---

<aside class="sidebar">
  <section class="widget widget-about">
    {avatar && <Image class="avatar" src={avatar} alt="" width={160} height={160} />}
    <h2>{AUTHOR_NAME}</h2>
    <p>{AUTHOR_BIO}</p>
  </section>

  {
    categories.length > 0 && (
      <section class="widget">
        <h2><a href="/categories/">Categories</a></h2>
        <ul class="widget-list">
          {categories.map(([slug, { name, count }]) => (
            <li>
              <a href={`/categories/${slug}/`}>{name}</a> <span class="count">({count})</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    tags.length > 0 && (
      <section class="widget">
        <h2><a href="/tags/">Tags</a></h2>
        <ul class="tag-list">
          {tags.map(([slug, { name }]) => (
            <li>
              <a class="tag" href={`/tags/${slug}/`}>#{name}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    months.length > 0 && (
      <section class="widget">
        <h2><a href="/archive/">Archives</a></h2>
        <ul class="widget-list">
          {months.map(({ year, month, label, posts }) => (
            <li>
              <a href={`/archive/${year}/${month}/`}>{label}</a>{' '}
              <span class="count">({posts.length})</span>
            </li>
          ))}
          {hasOlder && (
            <li>
              <a href="/archive/">All archives →</a>
            </li>
          )}
        </ul>
      </section>
    )
  }
</aside>
